{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/**,server/certs/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index" },
    { "src": "/admin(?:/.*)?", "dest": "/api/index" },
    { "src": "/(?:index\\.html)?", "dest": "/api/index" },
    { "handle": "filesystem" }
  ]
}

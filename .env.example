# Node.js 24+ is required. No secret values belong in VITE_* variables.
HOST=127.0.0.1
PORT=5173
DATABASE_PATH=./data/salon.sqlite
# Cloud database (server only). Setting DATABASE_URL selects Postgres; connection
# failures NEVER fall back to SQLite. Use your private salon_backend credential.
# SUPABASE_PROJECT_REF=your-project-ref
# DATABASE_URL=postgresql://salon_backend.PROJECT_REF:PRIVATE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres
# DATABASE_CA_PATH=server/certs/supabase-ca.crt
# Required in production; use the actual origin without a trailing slash.
# APP_ORIGIN=https://salon.example.com
# Vercel: set APP_ORIGIN to your production deployment origin and add the same
# private DATABASE_URL and DATABASE_CA_PATH in Project Settings > Environment Variables.
# Local .env files are not uploaded. Vercel requires Postgres, not DATABASE_PATH.
# Set only if your Node server is behind exactly one trusted reverse proxy.
# TRUST_PROXY=1

{
  "name": "luma-salon-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env server/index.js --preview",
    "lint": "eslint .",
    "test": "node --test",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "admin:create": "node --env-file-if-exists=.env server/admin-account.js",
    "admin:password": "node --env-file-if-exists=.env server/admin-account.js --reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
